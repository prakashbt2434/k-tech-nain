rules_version = '2';

// Storage rules: farmers upload their UPI QR code from /profile.
// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /qr-codes/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches("image/(png|jpeg|jpg)");
    }
  }
}
